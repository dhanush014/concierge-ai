# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
GROQ_API_KEY=
DATABASE_URL=
DEMO_PASSWORD=

# LangSmith tracing of the chat agent. Set LANGSMITH_TRACING=false to turn it off.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=concierge

# Web app (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
